{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (Debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "CORS_ORIGINS": "http://localhost:5173"
      },
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Backend: Tests (Debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "cwd": "${workspaceFolder}/backend",
      "justMyCode": false,
      "console": "integratedTerminal"
    }
  ]
}
